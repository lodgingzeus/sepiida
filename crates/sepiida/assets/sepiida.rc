// Windows resources of sepiida.exe and sepiidaw.exe: the app icon (shown
// by File Explorer, the taskbar, Alt+Tab and shortcuts) and the version
// information (Task Manager, file properties). build.rs defines the
// SEPIIDA_* macros. No #include: numeric values stand for winver.h's names
// (VOS_NT_WINDOWS32 = 0x40004, VFT_APP = 1, VS_FF_PRERELEASE = 2).
//
// sepiida.ico: 16-96 px frames as bitmaps, 256 px as PNG; 32 px and
// smaller are the tile edge to edge, larger ones from sepiida.png (the
// 1024 px master, tile at 90% of the canvas).

1 ICON SEPIIDA_ICON

1 VERSIONINFO
FILEVERSION SEPIIDA_VERSION_NUMBERS
PRODUCTVERSION SEPIIDA_VERSION_NUMBERS
FILEFLAGSMASK 0x3fL
FILEFLAGS SEPIIDA_FILE_FLAGS
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "sepiida"
            VALUE "ProductName", "sepiida"
            VALUE "FileVersion", SEPIIDA_VERSION
            VALUE "ProductVersion", SEPIIDA_VERSION
            VALUE "LegalCopyright", "GPL-3.0-only"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
